# Optional. Leave blank to use the fully local deterministic assistant.
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
AGNO_TELEMETRY=false

# Optional local demo account overrides. Defaults: demo / FinGuardDemo!
# Set before the first launch (the SQLite user is seeded once).
FINGUARD_DEMO_USER=demo
FINGUARD_DEMO_PASSWORD=FinGuardDemo!

# Optional MLflow destination. Empty keeps tracking local in ./mlruns.
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
